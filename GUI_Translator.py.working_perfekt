        # Sprachanzeige
        tk.Label(button_frame, text="Sprache:", bg=self.bg_color, fg=self.fg_color).pack(side=tk.LEFT, padx=(20, 5))
        self.language_label = tk.Label(
            button_frame,
            text="--",
